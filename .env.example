# rmlsa.sh configuration.
# Copy to `.env` (gitignored) and fill in. rmlsa.sh auto-loads `.env` next to it.
# Keep account-specific identifiers here, out of source control.
# AWS credentials are NOT set here — they come from your normal env / ~/.aws.

# Required: the admin EC2 instance id.
RMLSA_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown):
# RMLSA_REGION=us-west-2
# RMLSA_SSH_ALIAS=rmlsa                 # Host block in ~/.ssh/config
# RMLSA_REMOTE_DIR=~/rmlsa.com          # git checkout path on the box
# RMLSA_ADMIN_HOST=admin.rmlsa.com      # A record repointed on start
# RMLSA_HOSTED_ZONE_ID=                 # auto-resolved from the domain if empty
